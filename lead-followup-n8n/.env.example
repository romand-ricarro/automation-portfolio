# Copy to .env and fill in. Never commit .env.
# Base URL of the notification service (see ../notify-api). From inside Docker on macOS use host.docker.internal.
NOTIFY_API_URL=http://host.docker.internal:8000
# API key created with notify-api's POST /v1/keys endpoint
NOTIFY_API_KEY=replace-with-your-notify-api-key
# Shown in reply and follow-up emails
BUSINESS_NAME=Example Plumbing Co.
