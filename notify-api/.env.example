# Copy to .env and fill in. Never commit .env.
# Admin key for managing API keys (at least 16 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=replace-with-a-long-random-string
DATABASE_PATH=notify.db
DEFAULT_RATE_LIMIT_PER_MINUTE=60
# Comma-separated hosts the webhook channel may call. Empty = webhook channel disabled.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_TIMEOUT_SECONDS=5
